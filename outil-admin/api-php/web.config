<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS + PHP : équivalent du .htaccess (ignoré par Apache). -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="admin-config.php" />
          <add segment="admin-config.sample.php" />
        </hiddenSegments>
        <!-- 30 Mo max par requête (limite par défaut d'IIS) -->
        <requestLimits maxAllowedContentLength="30000000" />
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
