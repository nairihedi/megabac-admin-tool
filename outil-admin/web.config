<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS : l'interface (HTML/JS/CSS) est toujours revalidée (304 si inchangée),
     pour qu'un redéploiement soit visible sans vider le cache du navigateur. -->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
